---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { ThemeSwitcher } from '../components/ThemeSwitcher';
import type { Locale } from '../lib/types';
import { t } from '../lib/i18n';
import { aboutHref, homeHref, switchLocaleHref } from '../lib/runs';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const m = t(locale);
const base = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} · ${m.siteTitle}` : `${m.siteTitle} — ${m.siteTagline}`;
const desc = description ?? m.heroLead;
const pathname = Astro.url.pathname;
const otherLocale: Locale = locale === 'ru' ? 'en' : 'ru';
const otherHref = switchLocaleHref(
  pathname,
  base,
  otherLocale,
  Astro.url.search,
  Astro.url.hash,
);
const home = homeHref(locale, base);
const about = aboutHref(locale, base);
const isAbout = pathname.includes('/about');
---

<!doctype html>
<html lang={locale} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <title>{pageTitle}</title>
    <ClientRouter fallback="swap" />
    <script
      is:inline
      set:html={`
      (function () {
        var siteBase = ${JSON.stringify(base)};
        var PREFS_KEY = 'recipe-scaler-bench-prefs';
        var VIEW_COOKIE = 'rsb-view';
        var LEGACY_THEME_KEY = 'prefered-mode';
        var VALID_THEME = { system: true, light: true, dark: true, flashlight: true };

        function readPrefs() {
          try {
            var raw = localStorage.getItem(PREFS_KEY);
            if (raw) {
              var p = JSON.parse(raw);
              if (p && typeof p === 'object') return p;
            }
            var legacy = localStorage.getItem(LEGACY_THEME_KEY);
            if (VALID_THEME[legacy]) {
              var migrated = { theme: legacy, view: 'table' };
              localStorage.setItem(PREFS_KEY, JSON.stringify(migrated));
              try {
                localStorage.removeItem(LEGACY_THEME_KEY);
              } catch (e) {}
              return migrated;
            }
          } catch (e) {}
          return { theme: 'system', view: 'table' };
        }

        function syncViewCookie(view) {
          try {
            document.cookie = VIEW_COOKIE + '=' + view + ';path=/;max-age=31536000;SameSite=Lax';
          } catch (e) {}
        }

        function prefersDark() {
          return !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        }

        function resolveTheme(mode) {
          if (mode === 'dark') return 'dark';
          if (mode === 'light' || mode === 'flashlight') return 'light';
          return prefersDark() ? 'dark' : 'light';
        }

        function switchLocaleHref(pathname, base, target, search, hash) {
          var b = base.endsWith('/') ? base.slice(0, -1) : base;
          var path = pathname;
          if (path.indexOf(b) === 0) path = path.slice(b.length) || '/';
          if (path.charAt(0) !== '/') path = '/' + path;
          var isEn = path === '/en' || path.indexOf('/en/') === 0;
          var rest = isEn ? path.slice(3) || '/' : path;
          if (rest.charAt(0) !== '/') rest = '/' + rest;
          if (rest === '') rest = '/';
          var qs = !search || search === '?' ? '' : search.charAt(0) === '?' ? search : '?' + search;
          var frag = !hash || hash === '#' ? '' : hash.charAt(0) === '#' ? hash : '#' + hash;
          var href;
          if (target === 'en') {
            href = rest === '/' ? b + '/en/' : b + '/en' + (rest.charAt(rest.length - 1) === '/' ? rest : rest + '/');
          } else {
            href = rest === '/' ? b + '/' : b + (rest.charAt(rest.length - 1) === '/' ? rest : rest + '/');
          }
          return href + qs + frag;
        }

        function applyShellPrefs(opts) {
          opts = opts || {};
          var prefs = readPrefs();
          var mode = VALID_THEME[prefs.theme] ? prefs.theme : 'system';
          var root = document.documentElement;
          root.setAttribute('data-theme-mode', mode);
          root.setAttribute('data-theme-resolved', resolveTheme(mode));

          var view = prefs.view === 'gallery' ? 'gallery' : 'table';
          root.setAttribute('data-view', view);
          syncViewCookie(view);

          if (opts.deferExplorer) {
            var hasExplorer = !!document.querySelector('.results-explorer');
            if (
              hasExplorer &&
              ((location.search && location.search.length > 1) || view === 'gallery')
            ) {
              root.classList.add('defer-explorer');
            } else {
              root.classList.remove('defer-explorer');
            }
          }

          if (opts.redirectLocale !== false) {
            var pageLocale = root.getAttribute('lang') === 'en' ? 'en' : 'ru';
            if ((prefs.locale === 'en' || prefs.locale === 'ru') && prefs.locale !== pageLocale) {
              var next = switchLocaleHref(
                location.pathname,
                siteBase,
                prefs.locale,
                location.search,
                location.hash,
              );
              var current = location.pathname + location.search + location.hash;
              if (next && next !== current) {
                location.replace(next);
              }
            }
          }
        }

        applyShellPrefs({ deferExplorer: true });

        if (!window.__rsbShellPrefsBound) {
          window.__rsbShellPrefsBound = true;
          // Before React hydrates the swapped page: hide mismatched view/filters.
          document.addEventListener('astro:after-swap', function () {
            applyShellPrefs({ deferExplorer: true });
          });
          // Keep theme/data-view in sync without re-hiding after React revealed the explorer.
          document.addEventListener('astro:page-load', function () {
            applyShellPrefs({ deferExplorer: false });
          });
        }
      })();
    `}
    />
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell flex items-center gap-3 py-3">
        <a href={home} class="flex shrink-0 items-center" title={m.navResults} aria-label={m.siteTitle}>
          <img
            src={`${base}icon-192.png`}
            alt=""
            width="32"
            height="32"
            class="h-8 w-8 rounded-[6px]"
            loading="eager"
            decoding="async"
          />
        </a>
        <a href={home} class="min-w-0 flex-1" title={m.navResults}>
          <div class="truncate text-[28px] font-bold leading-none tracking-tight">{m.siteTitle}</div>
        </a>
        <nav class="flex items-center gap-1 font-medium">
          <a
            href={home}
            class:list={[
              'rounded-md px-2.5 py-1.5 hover:bg-[oklch(var(--accent))]',
              !isAbout && 'bg-[oklch(var(--accent))]',
            ]}>{m.navResults}</a
          >
          <a
            href={about}
            class:list={[
              'rounded-md px-2.5 py-1.5 hover:bg-[oklch(var(--accent))]',
              isAbout && 'bg-[oklch(var(--accent))]',
            ]}>{m.navAbout}</a
          >
          <a
            href={otherHref}
            class="rounded-md px-2.5 py-1.5 text-[oklch(var(--foreground))] hover:bg-[oklch(var(--accent))] hover:text-[oklch(var(--foreground))]"
            hreflang={otherLocale}
            data-locale-switch={otherLocale}
          >
            {otherLocale === 'en' ? m.langEn : m.langRu}
          </a>
          <script is:inline>
            (function () {
              var PREFS_KEY = 'recipe-scaler-bench-prefs';

              function syncLocaleSwitchHref(el) {
                var url = new URL(el.getAttribute('href') || el.href, location.href);
                el.setAttribute('href', url.pathname + location.search + location.hash);
              }

              // Capture phase: update href before ClientRouter handles the click.
              document.addEventListener(
                'click',
                function (e) {
                  var el = e.target && e.target.closest ? e.target.closest('[data-locale-switch]') : null;
                  if (!el) return;
                  var loc = el.getAttribute('data-locale-switch');
                  if (loc !== 'en' && loc !== 'ru') return;
                  try {
                    var prefs = {};
                    try {
                      prefs = JSON.parse(localStorage.getItem(PREFS_KEY) || '{}') || {};
                    } catch (err) {
                      prefs = {};
                    }
                    prefs.locale = loc;
                    if (!prefs.theme) prefs.theme = 'system';
                    if (!prefs.view) prefs.view = 'table';
                    localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
                  } catch (err) {}
                  syncLocaleSwitchHref(el);
                },
                true,
              );

              // Keep middle-click / open-in-new-tab hrefs fresh too.
              document.addEventListener(
                'pointerdown',
                function (e) {
                  var el = e.target && e.target.closest ? e.target.closest('[data-locale-switch]') : null;
                  if (el) syncLocaleSwitchHref(el);
                },
                true,
              );
            })();
          </script>
          <ThemeSwitcher client:load locale={locale} />
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="border-t border-[oklch(var(--border))] py-8 text-center text-[oklch(var(--foreground))]">
      <div class="site-shell flex flex-col items-center gap-2 sm:flex-row sm:justify-between">
        <span>{m.footerNote}</span>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            class="hover:underline"
            href={
              locale === 'en'
                ? 'https://mikeozornin.ru/blog/all/llm-and-ui-design-en/'
                : 'https://mikeozornin.ru/blog/all/llm-and-ui-design/'
            }
          >
            {m.blogPost}
          </a>
          <a class="hover:underline" href="https://recipe-scaler.ru/#/about">{m.product}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
