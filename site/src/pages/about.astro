---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../lib/i18n';

const locale = 'ru' as const;
const m = t(locale);
const promptPath = path.resolve(process.cwd(), '../task-paper-en.md');
const fullPrompt = fs.readFileSync(promptPath, 'utf8').trimEnd();
---

<BaseLayout locale={locale} title={m.aboutTitle}>
  <article class="prose-about max-w-3xl">
    <h1 class="mb-2 text-3xl font-bold tracking-tight">{m.aboutTitle}</h1>
    <p class="text-[oklch(var(--foreground))]">
      Я сгенерировал одну и ту же UI-задачу десятками агентов и моделей и собрал результаты в один
      стенд. Разница в стоимости между самым дорогим и дешёвым вариантом — 410×.
    </p>

    <h2>Цели</h2>
    <ul>
      <li>Насколько макеты похожи на решение задачи, насколько их можно использовать в работе</li>
      <li>Насколько чисто сверстано внутри</li>
      <li>Что по стоимости решения</li>
      <li>Насколько результат зависит от агента и от уровня reasoning</li>
    </ul>

    <h2>Процедура</h2>
    <p>
      Одна задача: три экрана для продукта Recipe Scaler — desktop (1400px), mobile recipe (375px),
      promo (1400px). Инструмент: Paper MCP (и частично Figma MCP). Контент в макетах — на английском.
      Каждому прогону — свежий файл, без правок руками (максимум растянуть фрейм).
    </p>

    <h3>Ограничения</h3>
    <ul>
      <li>Без уточнений по стилю и дизайн-системе; на вопросы не отвечал</li>
      <li>Максимальный reasoning/effort, кроме отдельных прогонов Opus 4.7 med</li>
      <li>Не чинил макеты — сравнение «что выдал агент»</li>
      <li>Английский текст в UI — небольшой чит по шрифтам vs кириллица</li>
    </ul>

    <h2>Промпт</h2>
    <p class="text-caption text-[oklch(var(--foreground))]">task-paper-en.md — полный текст задания</p>
    <pre class="mt-2"><code>{fullPrompt}</code></pre>

    <h2>Качество (тиры)</h2>
    <ul>
      <li><strong>Фенси</strong> — в основном Opus 4.7 (и близкие)</li>
      <li><strong>Середняк</strong> — аккуратно, но нейродизайн виден</li>
      <li><strong>Нейрослоп</strong> — слабо, особенно promo</li>
      <li><strong>Тулы не потянули</strong> — сломанные/пустые макеты</li>
    </ul>
    <p class="text-caption text-[oklch(var(--foreground))]">
      Тиры — черновая разметка по посту; можно править в <code>data/runs.json</code>.
    </p>

    <h2>Выводы</h2>
    <ol class="list-decimal space-y-2 pl-5">
      <li>Opus — на коне. Дорого и сильно лучше GPT 5.x на этой задаче.</li>
      <li>Китайские модели часто оверфитятся на бенчмарки; в реальной UI-задаче разброс огромный.</li>
      <li>Хорошая модель обесценивает «дизайн разработчиком/продактом» без вкуса; дизайнерам пока есть работа.</li>
    </ol>

    <h2>Ссылки</h2>
    <ul>
      <li>
        <a class="underline" href="https://mikeozornin.ru/blog/all/llm-and-ui-design/">Пост</a>
      </li>
      <li>
        <a class="underline" href="https://recipe-scaler.ru/#/about">recipe-scaler.ru</a>
      </li>
    </ul>
  </article>
</BaseLayout>
