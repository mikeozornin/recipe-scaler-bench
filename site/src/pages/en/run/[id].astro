---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ImageLightbox } from '../../../components/ImageLightbox';
import RunNav from '../../../components/RunNav.astro';
import {
  fullImagePath,
  getRunById,
  runs,
  thumbImagePath,
} from '../../../lib/runs';
import { getPrefs } from '../../../lib/prefs';
import { t } from '../../../lib/i18n';
import type { Locale } from '../../../lib/types';

export function getStaticPaths() {
  return runs.map((run) => ({ params: { id: run.id } }));
}

const locale: Locale = 'en';
const m = t(locale);
const base = import.meta.env.BASE_URL;
const { id } = Astro.params;
const run = getRunById(id!);
if (!run) {
  throw new Error(`Unknown run: ${id}`);
}
const comment = run.comment[locale];

const screens: { key: keyof typeof run.images; label: string }[] = [
  { key: 'all', label: m.screenAll },
  { key: 'desktop', label: m.screenDesktop },
  { key: 'mobile', label: m.screenMobile },
  { key: 'promo', label: m.screenPromo },
];

const items = screens
  .filter((s) => run.images[s.key])
  .map((s) => ({
    src: fullImagePath(run.images[s.key]!, base),
    label: s.label,
    thumb: thumbImagePath(run.images[s.key]!, base),
  }));

const timeRaw = run.time?.replace(/^~\s*/, '').trim() || '';
const tokensRaw = run.tokens?.trim() || '';
const costRaw = run.cost?.trim() || '';
const time = timeRaw && timeRaw !== '—' ? timeRaw : '';
const tokens = tokensRaw && tokensRaw !== '—' ? tokensRaw : '';
const cost = costRaw && costRaw !== '—' ? costRaw : '';
---

<BaseLayout locale={locale} title={`${run.model} (${run.agent})`} description={comment}>
  <header class="mb-6 space-y-3">
    <RunNav
      currentId={run.id}
      locale={locale}
      base={base}
      prevAria={m.prev}
      nextAria={m.next}
      fallbackSort={getPrefs().sort}
    />
    <h1 class="text-3xl font-bold tracking-tight">
      {run.model} ({run.agent})
    </h1>
    <div class="flex flex-wrap items-center gap-3 text-sm text-[oklch(var(--foreground))]">
      {time && (
        <span>{m.colTime}: <strong class="text-[oklch(var(--foreground))]">{time}</strong></span>
      )}
      {tokens && (
        <span>{m.colTokens}: <strong class="text-[oklch(var(--foreground))]">{tokens}</strong></span>
      )}
      {cost && (
        <span>{m.colCost}: <strong class="text-[oklch(var(--foreground))]">{cost}</strong></span>
      )}
      {run.tier !== 'unknown' && (
        <span class={`tier-badge tier-${run.tier}`}>{m.tiers[run.tier]}</span>
      )}
    </div>
    <p class="max-w-3xl">{comment}</p>
  </header>

  {
    items.length === 0 ? (
      <p class="text-[oklch(var(--foreground))]">{m.noImage}</p>
    ) : (
      <ImageLightbox
        client:idle
        items={items.map((i) => ({ src: i.src, label: i.label }))}
      />
    )
  }
</BaseLayout>
